# ==============================================================
# Outdoor Vacationz Backend Environment Variables
# ==============================================================

PORT=3001
CLIENT_URL=http://localhost:5173

# --------------------------------------------------------------
# Resend Email Configuration
# Get your API key from: https://resend.com/api-keys
# --------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here

# The sender email address.
# For testing (unverified domain), keep: Outdoor Vacationz <onboarding@resend.dev>
# For production (verified domain in Resend): Outdoor Vacationz <hello@outdoorvacationz.com>
RESEND_FROM_EMAIL="Outdoor Vacationz <onboarding@resend.dev>"

# Destination email where customer travel enquiries are sent
RESEND_TO_EMAIL=contact.outdoorvacationz@gmail.com
